# Nothing here is required for local development. Copy to .env and export the
# values you need (the app reads the process environment; it does not load .env itself).

# PostgreSQL with the pgvector extension. Default: the PGlite dev server (node devdb/server.mjs).
DATABASE_URL=

# Required when DJANGO_DEBUG is off.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Answers: set a key to use Claude; without one the offline extractive answerer is used.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Embeddings: set a key to use Voyage AI; without one the offline hashing embedder is used.
# Documents are embedded with the provider active at upload time; re-upload after switching.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5

# Tune per embedding model: below this cosine similarity a passage counts as irrelevant.
RAG_MIN_SIMILARITY=0.2
ASK_RATE_LIMIT=30/hour
MAX_UPLOAD_BYTES=5242880
